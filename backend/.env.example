# Copy to backend/.env (gitignored). Never commit real credentials.

# --- Required: signs login tokens. Use a long random value, at least 32 characters. ---
JWT_SECRET=

# --- Required with the dev profile: password of the four test accounts ---
# DEV_SEED_PASSWORD=

# --- Shared Supabase database (Supabase dashboard -> Connect -> Session pooler) ---
# Leave these out to use the local docker-compose database.
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database-password>

# --- Frontend origins allowed to call the API (comma-separated) ---
# CORS_ORIGINS=http://localhost:5173
